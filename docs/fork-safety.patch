       tls_verify_mode_(tls_verify_mode), custom_ca_pem_(std::move(custom_ca_pem)),
-      profile_(std::move(profile)) {}
+      profile_(std::move(profile)), fork_generation_(CurrentForkGeneration()) {}
 
