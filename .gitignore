# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python caches and virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Rust/Python build output. bindings/python36 is a separate crate with its own
# target directory, which the root pattern does not reach.
/target/
/bindings/*/target/
/dist/
*.whl

# Local Core binaries and platform dependencies are release artifacts. Keep
# target manifests tracked so a loader can verify provenance before loading.
/core/binaries/*/*.so
/core/binaries/*/*.dylib
/core/binaries/*/*.dll
/core/binaries/*/*.lib
/core/binaries/*/*.pdb
/core/dependencies/*/*
!/core/dependencies/README.md

# Local native staging
/native/
