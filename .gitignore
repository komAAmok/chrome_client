# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python caches and virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Rust/Python build output. bindings/python36 is a separate crate with its own
# target directory, which the root pattern does not reach.
/target/
/bindings/*/target/
/dist/
*.whl

# Local Core binaries and platform dependencies are release artifacts. The
# manifests AND the binaries under core/binaries are tracked intentionally: the
# loader needs them and tools/audit-core-binaries.sh verifies their SHA-256 and
# size against the manifests, so they are committed rather than ignored. Only
# the platform dependency staging area stays untracked.
/core/dependencies/*/*
!/core/dependencies/README.md

# Local native staging
/native/

# WorkBuddy session data (local notes, not part of the source tree)
/.workbuddy/
