diff --git a/base/nix/xdg_util_minicronet.cc b/base/nix/xdg_util_minicronet.cc
new file mode 100644
index 0000000000..0cde180b2d
--- /dev/null
+++ b/base/nix/xdg_util_minicronet.cc
@@ -0,0 +1,46 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/nix/xdg_util.h"
+
+#include <cstdlib>
+
+#include "base/base_paths.h"
+#include "base/environment.h"
+#include "base/files/file_path.h"
+#include "base/path_service.h"
+#include "base/third_party/xdg_user_dirs/xdg_user_dir_lookup.h"
+
+namespace base::nix {
+
+FilePath GetXDGDirectory(Environment* env,
+                         cstring_view env_name,
+                         const char* fallback_dir) {
+  FilePath path;
+  if (auto value = env->GetVar(env_name).value_or(""); !value.empty()) {
+    path = FilePath(value);
+  } else {
+    PathService::Get(DIR_HOME, &path);
+    path = path.Append(fallback_dir);
+  }
+  return path.StripTrailingSeparators();
+}
+
+FilePath GetXDGUserDirectory(const char* dir_name, const char* fallback_dir) {
+  FilePath path;
+  if (char* value = xdg_user_dir_lookup(dir_name)) {
+    path = FilePath(value);
+    free(value);
+  } else {
+    PathService::Get(DIR_HOME, &path);
+    path = path.Append(fallback_dir);
+  }
+  return path.StripTrailingSeparators();
+}
+
+FilePath GetXDGDataWriteLocation(Environment* env) {
+  return GetXDGDirectory(env, "XDG_DATA_HOME", ".local/share");
+}
+
+}  // namespace base::nix
